{
  "name": "@dreamer/plugins",
  "version": "1.2.0",
  "description": "Official plugin collection for dweb (tailwindcss, static, auth, etc.).",
  "type": "module",
  "exports": {
    ".": "./src/mod.ts",
    "./tailwindcss": "./src/tailwindcss/mod.ts",
    "./unocss": "./src/unocss/mod.ts",
    "./i18n": "./src/i18n/mod.ts",
    "./seo": "./src/seo/mod.ts",
    "./pwa": "./src/pwa/mod.ts",
    "./analytics": "./src/analytics/mod.ts",
    "./theme": "./src/theme/mod.ts",
    "./compression": "./src/compression/mod.ts",
    "./cors": "./src/cors/mod.ts",
    "./ratelimit": "./src/ratelimit/mod.ts",
    "./security": "./src/security/mod.ts",
    "./auth": "./src/auth/mod.ts",
    "./static": "./src/static/mod.ts",
    "./social": "./src/social/mod.ts",
    "./scheduled": "./src/scheduled/mod.ts",
    "./queue": "./src/queue/mod.ts"
  },
  "scripts": {
    "test": "deno test -A --minimum-dependency-age=0 --no-check tests/",
    "test:node": "node --import tsx --test-force-exit test-node.mjs",
    "check": "deno check src/mod.ts"
  },
  "dependencies": {
    "@dreamer/auth": "npm:@jsr/dreamer__auth@^1.1.0",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@^1.1.2",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.1.0",
    "@dreamer/plugin": "npm:@jsr/dreamer__plugin@^1.1.0",
    "@dreamer/queue": "npm:@jsr/dreamer__queue@^1.1.0",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.2",
    "@dreamer/service": "npm:@jsr/dreamer__service@^1.1.0",
    "@dreamer/theme": "npm:@jsr/dreamer__theme@^1.1.0",
    "@tailwindcss/postcss": "4.1.18",
    "@unocss/core": "66.0.0",
    "@unocss/preset-icons": "66.0.0",
    "@unocss/preset-wind3": "66.0.0",
    "postcss": "8.5.10",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "keywords": ["plugins", "tailwindcss", "dweb", "dreamer"]
}
