{
  "name": "@dreamer/plugins",
  "version": "1.2.0",
  "description": "dweb 框架的官方插件集合",
  "exports": {
    ".": "./src/mod.ts",
    "./tailwindcss": "./src/tailwindcss/mod.ts",
    "./unocss": "./src/unocss/mod.ts",
    "./i18n": "./src/i18n/mod.ts",
    "./seo": "./src/seo/mod.ts",
    "./pwa": "./src/pwa/mod.ts",
    "./analytics": "./src/analytics/mod.ts",
    "./theme": "./src/theme/mod.ts",
    "./compression": "./src/compression/mod.ts",
    "./cors": "./src/cors/mod.ts",
    "./ratelimit": "./src/ratelimit/mod.ts",
    "./security": "./src/security/mod.ts",
    "./auth": "./src/auth/mod.ts",
    "./static": "./src/static/mod.ts",
    "./social": "./src/social/mod.ts",
    "./scheduled": "./src/scheduled/mod.ts",
    "./queue": "./src/queue/mod.ts"
  },
  "publish": {
    "exclude": [
      "tests/",
      ".github/",
      "*.test.ts",
      "TEST_REPORT.md",
      "logs/"
    ]
  },
  "imports": {
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.0",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/theme": "jsr:@dreamer/theme@^1.1.0",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/auth": "jsr:@dreamer/auth@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/queue": "jsr:@dreamer/queue@^1.1.0",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "postcss": "npm:postcss@^8.5.10",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.1.18",
    "@unocss/core": "npm:@unocss/core@^66.0.0",
    "@unocss/preset-wind3": "npm:@unocss/preset-wind3@^66.0.0",
    "@unocss/preset-icons": "npm:@unocss/preset-icons@^66.0.0"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "0",
  "tasks": {
    "test": "deno test -A --minimum-dependency-age=0 --no-check tests/",
    "test:node": "node --import tsx --test-force-exit test-node.mjs",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.24.2",
      "npm:esbuild@0.27.2",
      "npm:puppeteer@24.36.1"
    ]
  }
}
